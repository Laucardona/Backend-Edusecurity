# Copia este archivo a .env (ignorado por Git) y reemplaza TODOS los valores.
# Genera valores con:  openssl rand -base64 48   |   openssl rand -hex 24

# Clave Base64 (mínimo 32 bytes) para firmar los JWT. La misma en todos los servicios.
JWT_SECRET=cambia-esto-por-una-clave-base64-de-al-menos-32-bytes

# Clave de llamadas servicio a servicio (cabecera X-Service-Key).
INTERNAL_API_KEY=cambia-esto

# PostgreSQL en Docker: superusuario y una contraseña distinta por servicio.
# Cada servicio usa su propio rol (auth_svc, contenido_svc, ...) dueño solo de su base.
POSTGRES_PASSWORD=cambia-esto
DB_PASSWORD_AUTH=cambia-esto
DB_PASSWORD_CONTENIDO=cambia-esto
DB_PASSWORD_PROGRESO=cambia-esto
DB_PASSWORD_SIMULACION=cambia-esto

# Correo SMTP (recuperación de contraseña). Sin MAIL_HOST no se envían correos.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Administrador inicial (auth-service). Sin ADMIN_PASSWORD no se crea ningún administrador.
# ADMIN_CORREO vacío usa admin@edusecurity.com. Usa una contraseña que cumpla la política
# (10+ caracteres, mayúscula, minúscula, número y especial) y cámbiala tras el primer ingreso.
ADMIN_CORREO=
ADMIN_PASSWORD=
