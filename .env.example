# Copia este archivo a .env (ignorado por Git) y reemplaza TODOS los valores.
# Genera valores con:  openssl rand -base64 48   |   openssl rand -hex 24

# Clave Base64 (mínimo 32 bytes) para firmar los JWT. La misma en todos los servicios.
JWT_SECRET=cambia-esto-por-una-clave-base64-de-al-menos-32-bytes

# Clave de llamadas servicio a servicio (cabecera X-Service-Key).
INTERNAL_API_KEY=cambia-esto

# MySQL en Docker
MYSQL_ROOT_PASSWORD=cambia-esto
DB_PASSWORD=cambia-esto

# Correo SMTP (recuperación de contraseña). Sin MAIL_HOST no se envían correos.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
